# EjoChat, used only by the explain screen to help a health worker put a
# result into words. The clinical decision never touches the network.
#
# Copy this file to .env and paste the key from https://ejolabs.com/tenant
# (Keys tab, available once the account is approved).
#
# Reba hides the whole feature while the key is empty, so the app runs
# perfectly well without it.
#
# EXPO_PUBLIC_ values are baked into the bundle and can be read out of a
# shipped app. Fine for a hackathon key; a real deployment needs a proxy.

EXPO_PUBLIC_EJOCHAT_KEY=

# Only needed if the documented endpoint ever changes.
# EXPO_PUBLIC_EJOCHAT_URL=https://api.ejolabs.com/api/v1/subiza
